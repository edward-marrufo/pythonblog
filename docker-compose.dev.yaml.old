#/basicblog/docker-compose.dev.yaml
services:
  postgres:
    image: postgres:17.9-trixie
    container_name: db
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    ports:
      - "5432:5432"
    volumes:
      - pg_data:/var/lib/postgresql/data

  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile.dev
    container_name: api
    command: uvicorn backend.app.main:app --host 0.0.0.0 --reload
    ports:
      - "8000:8000"
    env_file:
      - ./backend/.env
    depends_on:
      - postgres
    # Mount your local app folder for live code changes
    volumes:
      - ./backend:/app/backend:Z
    restart: unless-stopped

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile.dev
    container_name: frontend
    #tty: false
    ports:
      - "5173:5173"
    volumes:
      - ./frontend/app:/app:Z
    stop_grace_period: 10s
    depends_on:
      - backend
    restart: unless-stopped

  pg-admin:
    image: dpage/pgadmin4:9.12.0
    container_name: pgadmin
    environment:
      - PGADMIN_DEFAULT_EMAIL=${PGA_EMAIL}
      - PGADMIN_DEFAULT_PASSWORD=${PGA_PASSWORD}
      - PGADMIN_LISTEN_PORT=${PGA_PORT}
    ports:
      - "5050:5050"
    volumes:
      - pga_data:/var/lib/pgadmin

volumes:
  pg_data:
  api_data:
  pga_data: